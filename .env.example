DB_PASSWORD=replace-with-a-long-random-database-password
ADMIN_USERNAME=owner
# Bootstrap only when admin_users is empty; changing this does NOT reset an existing Owner.
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Base64 of exactly 32 random bytes; generate as described in README-IMPLEMENTATION.md
TOKEN_KEY=
APP_PUBLIC_ORIGIN=http://localhost:8088
# Production domain (không gồm scheme). Ví dụ: thiepcuoi.example.com
# Dùng domain này cho SITE_ADDRESS và APP_PUBLIC_ORIGIN bên dưới.
# DOMAIN=thiepcuoi.example.com

SITE_ADDRESS=:80
HTTP_PORT=8088
HTTPS_PORT=8443
COOKIE_SECURE=false